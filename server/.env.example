# 복사해서 .env 로 만든 뒤 값을 채운다. .env 는 .gitignore 에 있다.

# --- Elice MLAPI (판정·생성·인테이크 전부 이 모델) ---
# 형식: https://mlapi.run/<엔드포인트-id>/v1
# 끝의 /v1 이 없으면 404 다. Elice 콘솔의 예제 코드는 /v1 없이 POST 하지만
# openai SDK 를 쓰면 SDK 가 경로를 스스로 붙이지 않으므로 반드시 필요하다.
ELICE_MLAPI_BASE_URL=
ELICE_MLAPI_API_KEY=
# 모델 ID. verify_connection.py 가 /v1/models 로 실제 사용 가능한 값을 알려준다.
ELICE_MODEL=

# --- OpenAI Moderation 전용 ---
# Elice 에는 /v1/moderations 가 없어서(404) 진짜 OpenAI 키가 따로 필요하다.
# 이 키는 절대 ELICE 쪽과 공유하지 않는다.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- 공통 ---
MAX_OUTPUT_TOKENS=2048
ET_DB_PATH=neuringo_poc.db

# ---------------------------------------------------------------- Docker
# docker compose 는 이 파일을 복사한 server/.env 를 env_file 로 읽는다.
# 값이 비면 컨테이너가 뜨자마자 무엇이 비었는지 말하고 멈춘다(app/config.py).
# DB 경로는 compose 가 /data/neuringo_poc.db 로 덮으므로 여기서 건드리지 않는다.
