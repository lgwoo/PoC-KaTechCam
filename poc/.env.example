# 있는 키만 채우면 됨. 없는 provider는 자동으로 NO_API_KEY 처리되고 나머지는 계속 실행됨.

# --- GPT ---
OPENAI_API_KEY=
# 반드시 실제 사용 가능한 모델 ID로 확인 후 채울 것 (OpenAI 대시보드/문서 참고).
# 여기서 기본값을 임의로 넣지 않은 이유: 모델 세대가 자주 바뀌어 잘못된 값을 박아두면 조용히 깨질 수 있음.
OPENAI_MODEL=
# 공식 OpenAI가 아닌 제3자 브릿지를 거칠 때만 설정 (예: Timely GPT SDK
# https://hello.timelygpt.co.kr/api/v2/chat/bridge/openai).
# ⚠️ PoC 테스트 1회성 용도로만 사용할 것 — 실제 서비스나 실제 아동 데이터에는 쓰지 말 것
# (제3자 서버로 요청 내용이 그대로 전달됨). 설정 시 02-latency 결과는 브릿지 오버헤드가
# 포함되어 PERF-01~03(직접 API 기준) 목표치와 직접 비교할 수 없다.
# OPENAI_MODEL도 브릿지 쪽 표기(예: openai/gpt-4o-mini)로 맞춰야 함.
OPENAI_BASE_URL=
# OpenAI Moderation (텍스트 유해성 검사, 무료 — 과금 없음). OPENAI_API_KEY가 브릿지 키일 수
# 있어서 공유하지 않는다. 여기에 platform.openai.com에서 발급한 진짜 sk-... 키를 넣을 것.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Gemini ---
GEMINI_API_KEY=
# 마찬가지로 현재 사용 가능한 모델 ID를 Google AI Studio/문서에서 확인 후 채울 것.
# ⚠️ 브릿지(GEMINI_BASE_URL) 사용 시에는 브릿지 쪽 표기(예: google/gemini-3-flash-preview)로 채울 것.
GEMINI_MODEL=
# 설정 시 네이티브 Gemini SDK 대신 OpenAI 호환 브릿지로 라우팅 (GPT의 OPENAI_BASE_URL과 동일한 주의사항 적용).
# GEMINI_API_KEY 자리에는 브릿지 키(tgpt_sk_...)를 넣어야 함.
GEMINI_BASE_URL=

# --- Claude ---
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5 (2026-06-24 기준 확인된 모델 ID). 비용을 낮추고 싶으면 claude-sonnet-5 등으로 교체.
# ⚠️ 브릿지(CLAUDE_BASE_URL) 사용 시에는 브릿지 쪽 표기(예: anthropic/claude-sonnet-4.6)로 바꿔야 함.
CLAUDE_MODEL=claude-opus-5
# 설정 시 네이티브 Anthropic SDK 대신 OpenAI 호환 브릿지로 라우팅 (GPT의 OPENAI_BASE_URL과 동일한 주의사항 적용).
# ANTHROPIC_API_KEY 자리에는 브릿지 키(tgpt_sk_...)를 넣어야 함.
CLAUDE_BASE_URL=

# --- 공통 ---
# 각 provider 호출 시 사용할 max output tokens (05-recommend-report처럼 JSON이 긴 테스트가 있어 2048 기본)
MAX_OUTPUT_TOKENS=2048
# 02-latency 테스트에서 provider별 반복 호출 횟수
LATENCY_SAMPLES=5
